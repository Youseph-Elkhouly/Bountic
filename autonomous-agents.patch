+++ b/apps/web/components/AgentActivityFeed.tsx
@@ -0,0 +1,81 @@
+"use client";
+
+import Link from "next/link";
+import { useCallback, useEffect, useState } from "react";
+import { apiFetch } from "@/lib/api";
+
+type AgentState = { id: string; name: string; autonomy_enabled: boolean; available: boolean; max_concurrent_jobs: number; max_jobs_per_day: number; jobsToday: number; openJobs: number };
+type Run = { id: string; agent_id: string; bounty_id: string; status: string; bid_base_units: string | null; deliverable: string | null; executor: string | null; tokens_used: number; error: string | null; started_at: string; bounties: { title: string } | null };
+type RunEvent = { id: number; run_id: string | null; agent_id: string; kind: string; message: string; created_at: string };
+type Activity = { agents: AgentState[]; runs: Run[]; events: RunEvent[] };
+
+const ago = (iso: string) => {
+  const seconds = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 1000));
+  if (seconds < 60) return `${seconds}s ago`;
+  if (seconds < 3600) return `${Math.round(seconds / 60)}m ago`;
+  return `${Math.round(seconds / 3600)}h ago`;
+};
+const RUN_LABEL: Record<string, string> = { claimed: "claimed", working: "working", awaiting_review: "needs your OK", submitted: "submitted", failed: "failed", skipped: "skipped" };
+
+export function AgentActivityFeed({ highlightAgentId }: { highlightAgentId?: string }) {
+  const [data, setData] = useState<Activity | null>(null);
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState<string | null>(null);
+  const [open, setOpen] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    try { setData(await apiFetch<Activity>("/api/agent-activity")); setError(""); }
+    catch (e) { setError(e instanceof Error ? e.message : "Could not load agent activity"); }
+  }, []);
+  useEffect(() => {
+    const first = setTimeout(() => void load(), 0);
+    const timer = setInterval(() => { if (document.visibilityState === "visible") void load(); }, 3000);
+    return () => { clearTimeout(first); clearInterval(timer); };
+  }, [load]);
+
+  async function act(key: string, action: () => Promise<unknown>) {
+    setBusy(key);
+    try { await action(); await load(); } catch (e) { setError(e instanceof Error ? e.message : "Action failed"); }
+    setBusy(null);
+  }
+  const toggle = (agent: AgentState) => act(`toggle:${agent.id}`, () => apiFetch(`/api/agents/${agent.id}`, { method: "PATCH", body: JSON.stringify({ autonomyEnabled: !agent.autonomy_enabled }) }));
+  const runNow = (agent: AgentState) => act(`run:${agent.id}`, () => apiFetch(`/api/agents/${agent.id}/run-now`, { method: "POST", body: "{}" }));
+  const approve = (run: Run) => act(`approve:${run.id}`, () => apiFetch(`/api/agent-runs/${run.id}/submit`, { method: "POST", body: "{}" }));
+
+  if (!data) return <div className="empty-state compact">{error ? <><h3>Autopilot feed unavailable</h3><p>{error}</p></> : <p>Loading agent activity…</p>}</div>;
+  if (!data.agents.length) return <div className="empty-state"><h3>No agents yet</h3><p>Build an agent, switch on autopilot, and it will start picking up matching bounties on its own.</p><Link className="button-primary mt-4" href="/agents/new">Open the agent builder</Link></div>;
+  const names = new Map(data.agents.map((agent) => [agent.id, agent.name]));
+
+  return <div className="autopilot">
+    {error && <p className="notice-error mb-3">{error}</p>}
+    <div className="autopilot-agents">
+      {data.agents.map((agent) => <article key={agent.id} className={`autopilot-agent ${highlightAgentId === agent.id ? "is-new" : ""}`}>
+        <div className="flex items-start justify-between gap-3">
+          <div><h3>{agent.name}</h3><p className={`autopilot-state ${agent.autonomy_enabled && agent.available ? "is-live" : ""}`}><i />{!agent.available ? "Paused" : agent.autonomy_enabled ? agent.openJobs ? `Working on ${agent.openJobs} job${agent.openJobs > 1 ? "s" : ""}` : "Watching for work" : "Autopilot off"}</p></div>
+          <button type="button" role="switch" aria-checked={agent.autonomy_enabled} aria-label={`Autopilot for ${agent.name}`} className={`mini-toggle ${agent.autonomy_enabled ? "is-on" : ""}`} disabled={busy === `toggle:${agent.id}`} onClick={() => toggle(agent)}><span /></button>
+        </div>
+        <div className="usage"><span>Today</span><div className="usage-bar"><i style={{ width: `${Math.min(100, (agent.jobsToday / agent.max_jobs_per_day) * 100)}%` }} /></div><span>{agent.jobsToday}/{agent.max_jobs_per_day}</span></div>
+        <div className="usage"><span>Now</span><div className="usage-bar"><i style={{ width: `${Math.min(100, (agent.openJobs / agent.max_concurrent_jobs) * 100)}%` }} /></div><span>{agent.openJobs}/{agent.max_concurrent_jobs}</span></div>
+        <div className="mt-3 flex gap-2"><button type="button" className="button-secondary h-8 min-h-0 px-3 text-xs" disabled={busy === `run:${agent.id}` || !agent.available} onClick={() => runNow(agent)}>{busy === `run:${agent.id}` ? "Running…" : "Run now"}</button><Link className="button-secondary h-8 min-h-0 px-3 text-xs" href={`/agents/${agent.id}`}>Configure</Link></div>
+      </article>)}
+    </div>
+
+    <div className="autopilot-columns">
+      <section>
+        <h3 className="autopilot-subhead">Live log</h3>
+        {data.events.length ? <ol className="event-log">{data.events.slice(0, 14).map((event) => <li key={event.id} className={`event event-${event.kind}`}><i aria-hidden /><div><p>{event.message}</p><small>{names.get(event.agent_id)} · {ago(event.created_at)}</small></div></li>)}</ol>
+          : <p className="text-sm text-neutral-500">Nothing yet. With autopilot on, agents check for new bounties every few seconds.</p>}
+      </section>
+      <section>
+        <h3 className="autopilot-subhead">Jobs</h3>
+        {data.runs.length ? <div className="space-y-2">{data.runs.slice(0, 10).map((run) => <article key={run.id} className="run-card">
+          <div className="flex items-start justify-between gap-3"><div className="min-w-0"><Link href={`/bounties/${run.bounty_id}`} className="run-title">{run.bounties?.title ?? "Bounty"}</Link><small>{names.get(run.agent_id)} · bid {run.bid_base_units ? BigInt(run.bid_base_units).toLocaleString() : "-"} · {run.executor ?? "pending"} · {ago(run.started_at)}</small></div><span className={`run-status run-${run.status}`}>{RUN_LABEL[run.status] ?? run.status}</span></div>
+          {run.error && <p className="mt-2 text-xs text-red-700">{run.error}</p>}
+          {run.deliverable && <button type="button" className="mt-2 text-xs underline" onClick={() => setOpen(open === run.id ? null : run.id)}>{open === run.id ? "Hide deliverable" : "View deliverable"}</button>}
+          {open === run.id && run.deliverable && <pre className="deliverable">{run.deliverable}</pre>}
+          {run.status === "awaiting_review" && <button type="button" className="button-primary mt-3 h-8 min-h-0 px-3 text-xs" disabled={busy === `approve:${run.id}`} onClick={() => approve(run)}>Approve and submit</button>}
+        </article>)}</div> : <p className="text-sm text-neutral-500">No jobs yet.</p>}
+      </section>
+    </div>
+  </div>;
+}
