@@ -0,0 +1,21 @@
+import { env } from "../env.js";
+import { admin } from "../supabase.js";
+import { BackboardExecutor, RoutingExecutor, WebhookExecutor } from "./executors.js";
+import { startAgentWorker } from "./runner.js";
+import { SupabaseRunStore } from "./supabaseStore.js";
+
+export const runStore = new SupabaseRunStore(admin);
+export const agentExecutor = new RoutingExecutor(
+  new BackboardExecutor({ apiKey: env.backboardApiKey, baseUrl: env.backboardApiUrl }, runStore),
+  new WebhookExecutor(),
+);
+
+export function maybeStartAgentWorker() {
+  if (!env.agentRunnerEnabled) return null;
+  console.log(`Agent runner on: scanning every ${env.agentRunnerIntervalMs / 1000}s (${env.backboardApiKey ? "hosted agents run on Backboard" : "BACKBOARD_API_KEY not set, simulated output"})`);
+  return startAgentWorker(runStore, agentExecutor, env.agentRunnerIntervalMs);
+}
+
+export { tickAgent, tickAll } from "./runner.js";
+export { AGENT_COLUMNS } from "./supabaseStore.js";
+export { isAllowedAgentEndpoint } from "./executors.js";
diff --git a/services/api/src/agents/memoryStore.ts b/services/api/src/agents/memoryStore.ts
new file mode 100644
index 0000000..4fa8b47
--- /dev/null
+++ b/services/api/src/agents/memoryStore.ts
@@ -0,0 +1,66 @@
+import { randomUUID } from "node:crypto";
+import type { AgentConfig, BountyForAgent, EventKind, RunPatch, RunStatus, RunStore, SubmissionInput } from "./types.js";
+
+export type MemoryRun = { id: string; agent_id: string; bounty_id: string; status: RunStatus; match_score: number; bid_base_units: string; started_at: string } & RunPatch;
+export type MemoryEvent = { agentId: string; runId: string | null; kind: EventKind; message: string; data?: Record<string, unknown>; at: string };
+
+/** In-process store for tests and the CLI demo. Mirrors the database's unique (agent, bounty) claim. */
+export class MemoryRunStore implements RunStore {
+  agents = new Map<string, AgentConfig>();
+  bounties = new Map<string, BountyForAgent>();
+  runs: MemoryRun[] = [];
+  submissions: Array<SubmissionInput & { id: string }> = [];
+  matches = new Map<string, { score: number; status: string }>();
+  events: MemoryEvent[] = [];
+  onEvent?: (event: MemoryEvent) => void;
+
+  constructor(private readonly clock: () => number = Date.now) {}
+
+  async listAutonomousAgents() { return [...this.agents.values()].filter((agent) => agent.autonomy_enabled && agent.available); }
+  async getAgent(id: string) { const agent = this.agents.get(id); return agent ? { ...agent } : null; }
+  async countOpenRuns(agentId: string) { return this.runs.filter((run) => run.agent_id === agentId && (run.status === "claimed" || run.status === "working")).length; }
+  async countRunsSince(agentId: string, since: string) { return this.runs.filter((run) => run.agent_id === agentId && run.started_at >= since && run.status !== "skipped").length; }
+  async listCandidateBounties(agentId: string) {
+    const taken = new Set(this.runs.filter((run) => run.agent_id === agentId).map((run) => run.bounty_id));
+    return [...this.bounties.values()]
+      .filter((bounty) => bounty.status === "active" && !taken.has(bounty.id) && this.matches.get(`${bounty.id}:${agentId}`)?.status !== "declined")
+      .map((bounty) => ({ ...bounty, match_score: this.matches.get(`${bounty.id}:${agentId}`)?.score ?? bounty.match_score ?? null }));
+  }
+  async getBounty(id: string) { const bounty = this.bounties.get(id); return bounty ? { ...bounty } : null; }
+  async claimRun(input: { agentId: string; agentName: string; bountyId: string; matchScore: number; bidBaseUnits: string }) {
+    if (this.runs.some((run) => run.agent_id === input.agentId && run.bounty_id === input.bountyId)) return null;
+    const run: MemoryRun = { id: randomUUID(), agent_id: input.agentId, bounty_id: input.bountyId, status: "claimed", match_score: input.matchScore, bid_base_units: input.bidBaseUnits, started_at: new Date(this.clock()).toISOString() };
+    this.runs.push(run);
+    return { id: run.id };
+  }
+  async updateRun(id: string, patch: RunPatch) { const run = this.runs.find((item) => item.id === id); if (run) Object.assign(run, patch); }
+  async failStaleRuns(olderThan: string) {
+    let count = 0;
+    for (const run of this.runs) if ((run.status === "claimed" || run.status === "working") && run.started_at < olderThan) { run.status = "failed"; run.error = "Run timed out"; count++; }
+    return count;
+  }
+  async acceptMatch(input: { agentId: string; bountyId: string; score: number }) { this.matches.set(`${input.bountyId}:${input.agentId}`, { score: input.score, status: "accepted" }); }
+  async createSubmission(input: SubmissionInput) { const id = randomUUID(); this.submissions.push({ ...input, id }); return { id }; }
+  async saveAssistantId(agentId: string, assistantId: string) { const agent = this.agents.get(agentId); if (agent) agent.backboard_assistant_id = assistantId; }
+  async logEvent(input: { agentId: string; runId: string | null; kind: EventKind; message: string; data?: Record<string, unknown> }) {
+    const event = { ...input, at: new Date(this.clock()).toISOString() };
+    this.events.push(event);
+    this.onEvent?.(event);
+  }
+}
+
+export function agentFixture(overrides: Partial<AgentConfig> = {}): AgentConfig {
+  return {
+    id: randomUUID(), owner_id: randomUUID(), name: "Agent", description: "", skills: [], categories: [], capabilities: [],
+    min_reward_base_units: "0", available: true, autonomy_enabled: true, runtime: "hosted", model: "auto", instructions: "",
+    webhook_url: null, max_concurrent_jobs: 1, max_jobs_per_day: 5, bid_percent: 90, max_bid_base_units: null,
+    max_tokens_per_job: 4000, auto_submit: true, backboard_assistant_id: null, memory_enabled: true, web_search_enabled: false, ...overrides,
+  };
+}
+
+export function bountyFixture(overrides: Partial<BountyForAgent> = {}): BountyForAgent {
+  return {
+    id: randomUUID(), title: "A bounty", description: "Do a thing that is well described.", category: "writing", required_skills: [],
+    deliverable_requirements: "", max_budget_base_units: "1000", deadline: new Date(Date.now() + 86_400_000).toISOString(), status: "active", match_score: null, ...overrides,
+  };
+}
diff --git a/services/api/src/agents/policy.ts b/services/api/src/agents/policy.ts
new file mode 100644
index 0000000..45b3462
--- /dev/null
+++ b/services/api/src/agents/policy.ts
@@ -0,0 +1,44 @@
+import type { AgentConfig, BountyForAgent } from "./types.js";
+
+const lower = (values: string[] | null | undefined) => (values ?? []).map((value) => value.trim().toLowerCase()).filter(Boolean);
+
+/**
+ * Hard eligibility rules. These are limits, not ranking: the engine (or the
+ * fallback fit score below) decides order, but nothing ineligible is ever claimed.
+ */
+export function eligibility(agent: AgentConfig, bounty: BountyForAgent, now = Date.now()): { ok: true } | { ok: false; reason: string } {
+  if (bounty.status !== "active") return { ok: false, reason: "bounty is not open" };
+  if (new Date(bounty.deadline).getTime() <= now + 60_000) return { ok: false, reason: "deadline has passed or is too close" };
+  if (BigInt(bounty.max_budget_base_units) < BigInt(agent.min_reward_base_units || "0")) return { ok: false, reason: "budget is below the agent's minimum reward" };
+  const categories = lower(agent.categories);
+  if (categories.length && !categories.includes(bounty.category.trim().toLowerCase())) return { ok: false, reason: `category "${bounty.category}" is outside this agent's categories` };
+  const required = lower(bounty.required_skills);
+  const skills = new Set(lower(agent.skills));
+  if (required.length && !required.some((skill) => skills.has(skill))) return { ok: false, reason: "none of the required skills match" };
+  if (bid(agent, bounty) === null) return { ok: false, reason: "no bid fits between the minimum reward and the agent's bid cap" };
+  return { ok: true };
+}
+
+/** Fallback fit score in [0,1] when the engine has not scored this pair: share of required skills covered. */
+export function fitScore(agent: AgentConfig, bounty: BountyForAgent): number {
+  if (typeof bounty.match_score === "number" && Number.isFinite(bounty.match_score)) return Math.min(1, Math.max(0, bounty.match_score));
+  const required = lower(bounty.required_skills);
+  if (!required.length) return 0.5;
+  const skills = new Set(lower(agent.skills));
+  return required.filter((skill) => skills.has(skill)).length / required.length;
+}
+
+/** Proposed payout: bid_percent of the escrowed budget, capped by the owner's max bid, never below the minimum reward. */
+export function bid(agent: AgentConfig, bounty: BountyForAgent): string | null {
+  const budget = BigInt(bounty.max_budget_base_units);
+  let amount = (budget * BigInt(agent.bid_percent)) / 100n;
+  if (agent.max_bid_base_units) {
+    const cap = BigInt(agent.max_bid_base_units);
+    if (amount > cap) amount = cap;
+  }
+  const minimum = BigInt(agent.min_reward_base_units || "0");
+  if (amount < minimum) amount = minimum;
+  if (amount <= 0n || amount > budget) return null;
+  if (agent.max_bid_base_units && amount > BigInt(agent.max_bid_base_units)) return null;
+  return amount.toString();
+}
diff --git a/services/api/src/agents/runner.ts b/services/api/src/agents/runner.ts
new file mode 100644
index 0000000..1ed1dfb
--- /dev/null
+++ b/services/api/src/agents/runner.ts
@@ -0,0 +1,126 @@
+import { bid, eligibility, fitScore } from "./policy.js";
+import type { AgentConfig, BountyForAgent, Executor, RunStore } from "./types.js";
+
+export const STALE_RUN_MS = 15 * 60 * 1000;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export type AgentTickResult = { agentId: string; claimed: number; submitted: number; failed: number; skipped: string | null };
+
+/**
+ * One scheduling pass for one agent: check the owner's limits, pick the best
+ * eligible open bounties, claim them, do the work, and submit (or hold for review).
+ * Safe to run from several workers at once: the (agent, bounty) claim is unique.
+ */
+export async function tickAgent(store: RunStore, executor: Executor, agentInput: AgentConfig, options: { now?: () => number; force?: boolean } = {}): Promise<AgentTickResult> {
+  const now = options.now ?? Date.now;
+  const result: AgentTickResult = { agentId: agentInput.id, claimed: 0, submitted: 0, failed: 0, skipped: null };
+  const agent = await store.getAgent(agentInput.id);
+  if (!agent || !agent.available || (!agent.autonomy_enabled && !options.force)) {
+    result.skipped = "autopilot is off";
+    return result;
+  }
+
+  const open = await store.countOpenRuns(agent.id);
+  const slots = agent.max_concurrent_jobs - open;
+  if (slots <= 0) { result.skipped = "at its concurrent job limit"; return result; }
+  const today = await store.countRunsSince(agent.id, new Date(now() - DAY_MS).toISOString());
+  const dailyLeft = agent.max_jobs_per_day - today;
+  if (dailyLeft <= 0) {
+    result.skipped = "daily job limit reached";
+    await store.logEvent({ agentId: agent.id, runId: null, kind: "limit", message: `Daily limit of ${agent.max_jobs_per_day} jobs reached; waiting until it resets.` });
+    return result;
+  }
+
+  const candidates = await store.listCandidateBounties(agent.id);
+  const ranked = candidates
+    .map((bounty) => ({ bounty, check: eligibility(agent, bounty, now()), score: fitScore(agent, bounty) }))
+    .filter((item): item is { bounty: BountyForAgent; check: { ok: true }; score: number } => item.check.ok)
+    .sort((a, b) => {
+      if (b.score !== a.score) return b.score - a.score;
+      const budgetA = BigInt(a.bounty.max_budget_base_units), budgetB = BigInt(b.bounty.max_budget_base_units);
+      return budgetB > budgetA ? 1 : budgetB < budgetA ? -1 : 0;
+    });
+
+  if (options.force || ranked.length) {
+    await store.logEvent({ agentId: agent.id, runId: null, kind: "scan", message: ranked.length ? `Scanned ${candidates.length} open bounties; ${ranked.length} fit this agent.` : `Scanned ${candidates.length} open bounties; none fit this agent's skills, categories and limits.`, data: { candidates: candidates.length, eligible: ranked.length } });
+  }
+
+  const picks = ranked.slice(0, Math.min(slots, dailyLeft));
+  const runs = await Promise.allSettled(picks.map(async ({ bounty, score }) => {
+    const proposed = bid(agent, bounty)!;
+    const run = await store.claimRun({ agentId: agent.id, agentName: agent.name, bountyId: bounty.id, matchScore: score, bidBaseUnits: proposed });
+    if (!run) return "lost";
+    result.claimed++;
+    await store.acceptMatch({ agentId: agent.id, bountyId: bounty.id, score });
+    await store.logEvent({ agentId: agent.id, runId: run.id, kind: "claimed", message: `Picked up "${bounty.title}" (${Math.round(score * 100)}% fit, bidding ${proposed} base units).`, data: { bountyId: bounty.id, score, bid: proposed } });
+    try {
+      await store.updateRun(run.id, { status: "working" });
+      await store.logEvent({ agentId: agent.id, runId: run.id, kind: "working", message: `Working on "${bounty.title}"…`, data: { bountyId: bounty.id, runtime: agent.runtime } });
+      const output = await executor.execute({ agent, bounty, maxTokens: agent.max_tokens_per_job });
+      await store.updateRun(run.id, { deliverable: output.deliverable, executor: output.executor, tokens_used: output.tokensUsed, ...(output.threadId ? { backboard_thread_id: output.threadId } : {}) });
+      await store.logEvent({ agentId: agent.id, runId: run.id, kind: "drafted", message: `Drafted a ${output.deliverable.length.toLocaleString()}-character deliverable${output.tokensUsed ? ` using ${output.tokensUsed.toLocaleString()} tokens` : ""} (${output.executor})${output.memoriesUsed ? `, drawing on ${output.memoriesUsed} memor${output.memoriesUsed === 1 ? "y" : "ies"} from past jobs` : ""}.`, data: { bountyId: bounty.id, executor: output.executor, tokensUsed: output.tokensUsed, threadId: output.threadId ?? null } });
+
+      // Re-check the kill switch and the bounty right before anything leaves the platform.
+      const [latestAgent, latestBounty] = await Promise.all([store.getAgent(agent.id), store.getBounty(bounty.id)]);
+      if (!latestAgent?.available || (!latestAgent.autonomy_enabled && !options.force)) {
+        await store.updateRun(run.id, { status: "awaiting_review", finished_at: new Date(now()).toISOString() });
+        await store.logEvent({ agentId: agent.id, runId: run.id, kind: "paused", message: "Autopilot was switched off mid-task, so the draft is held for your review." });
+        return "held";
+      }
+      if (!latestBounty || latestBounty.status !== "active" || new Date(latestBounty.deadline).getTime() <= now()) {
+        await store.updateRun(run.id, { status: "skipped", error: "Bounty closed before submission", finished_at: new Date(now()).toISOString() });
+        await store.logEvent({ agentId: agent.id, runId: run.id, kind: "skipped", message: `"${bounty.title}" closed before the agent could submit.` });
+        return "closed";
+      }
+      if (output.tokensUsed > agent.max_tokens_per_job) {
+        await store.updateRun(run.id, { status: "awaiting_review", finished_at: new Date(now()).toISOString() });
+        await store.logEvent({ agentId: agent.id, runId: run.id, kind: "limit", message: `Used ${output.tokensUsed.toLocaleString("en-US")} tokens, over the ${agent.max_tokens_per_job.toLocaleString("en-US")}-token limit, so the draft is held for your review.`, data: { tokensUsed: output.tokensUsed } });
+        return "held";
+      }
+      if (!agent.auto_submit) {
+        await store.updateRun(run.id, { status: "awaiting_review", finished_at: new Date(now()).toISOString() });
+        await store.logEvent({ agentId: agent.id, runId: run.id, kind: "paused", message: "Draft ready. Auto-submit is off, so it is waiting for your approval." });
+        return "held";
+      }
+      const submission = await store.createSubmission({
+        bountyId: bounty.id, agentId: agent.id, proposedAmountBaseUnits: proposed,
+        deliverableType: output.deliverableUrl ? "external_link" : "text", deliverableUrl: output.deliverableUrl,
+        description: output.deliverable.slice(0, 8000),
+      });
+      await store.updateRun(run.id, { status: "submitted", submission_id: submission.id, finished_at: new Date(now()).toISOString() });
+      await store.logEvent({ agentId: agent.id, runId: run.id, kind: "submitted", message: `Submitted to "${bounty.title}" for ${proposed} base units. Waiting on the requester.`, data: { bountyId: bounty.id, submissionId: submission.id } });
+      result.submitted++;
+      return "submitted";
+    } catch (error) {
+      const message = error instanceof Error ? error.message : "Unknown error";
+      result.failed++;
+      await store.updateRun(run.id, { status: "failed", error: message.slice(0, 1000), finished_at: new Date(now()).toISOString() });
+      await store.logEvent({ agentId: agent.id, runId: run.id, kind: "failed", message: `Failed on "${bounty.title}": ${message}`.slice(0, 1000), data: { bountyId: bounty.id } });
+      return "failed";
+    }
+  }));
+  for (const run of runs) if (run.status === "rejected") console.error("agent run crashed", run.reason);
+  return result;
+}
+
+/** One pass over every agent with autopilot on. */
+export async function tickAll(store: RunStore, executor: Executor, options: { now?: () => number } = {}) {
+  const now = options.now ?? Date.now;
+  await store.failStaleRuns(new Date(now() - STALE_RUN_MS).toISOString());
+  const agents = await store.listAutonomousAgents();
+  const results = await Promise.allSettled(agents.map((agent) => tickAgent(store, executor, agent, options)));
+  return results.map((item, index) => item.status === "fulfilled" ? item.value : { agentId: agents[index].id, claimed: 0, submitted: 0, failed: 1, skipped: "crashed" });
+}
+
+/** Background loop inside the API process. Never overlaps itself. */
+export function startAgentWorker(store: RunStore, executor: Executor, intervalMs: number) {
+  let running = false;
+  const timer = setInterval(async () => {
+    if (running) return;
+    running = true;
+    try { await tickAll(store, executor); } catch (error) { console.error("agent worker tick failed", error instanceof Error ? error.message : error); }
+    finally { running = false; }
+  }, intervalMs);
+  timer.unref?.();
+  return () => clearInterval(timer);
+}
diff --git a/services/api/src/agents/supabaseStore.ts b/services/api/src/agents/supabaseStore.ts
new file mode 100644
index 0000000..6fe4202
--- /dev/null
+++ b/services/api/src/agents/supabaseStore.ts
@@ -0,0 +1,112 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import type { AgentConfig, BountyForAgent, RunStore } from "./types.js";
+
+export const AGENT_COLUMNS = "id,owner_id,name,description,skills,categories,capabilities,min_reward_base_units,available,autonomy_enabled,runtime,model,instructions,webhook_url,max_concurrent_jobs,max_jobs_per_day,bid_percent,max_bid_base_units,max_tokens_per_job,auto_submit,backboard_assistant_id,memory_enabled,web_search_enabled";
+const BOUNTY_COLUMNS = "id,title,description,category,required_skills,deliverable_requirements,max_budget_base_units,deadline,status";
+
+const asAgent = (row: Record<string, unknown>): AgentConfig => ({
+  ...(row as unknown as AgentConfig),
+  min_reward_base_units: String(row.min_reward_base_units ?? "0"),
+  max_bid_base_units: row.max_bid_base_units === null || row.max_bid_base_units === undefined ? null : String(row.max_bid_base_units),
+});
+const asBounty = (row: Record<string, unknown>, score?: number | null): BountyForAgent => ({
+  ...(row as unknown as BountyForAgent),
+  max_budget_base_units: String(row.max_budget_base_units),
+  required_skills: (row.required_skills as string[]) ?? [],
+  match_score: score ?? null,
+});
+
+function must<T>(result: { data: T; error: { message: string } | null }): T {
+  if (result.error) throw new Error(result.error.message);
+  return result.data;
+}
+
+export class SupabaseRunStore implements RunStore {
+  constructor(private readonly db: SupabaseClient) {}
+
+  async listAutonomousAgents() {
+    const rows = must(await this.db.from("agents").select(AGENT_COLUMNS).eq("autonomy_enabled", true).eq("available", true).limit(500));
+    return (rows ?? []).map((row) => asAgent(row as Record<string, unknown>));
+  }
+
+  async getAgent(agentId: string) {
+    const row = must(await this.db.from("agents").select(AGENT_COLUMNS).eq("id", agentId).maybeSingle());
+    return row ? asAgent(row as Record<string, unknown>) : null;
+  }
+
+  async countOpenRuns(agentId: string) {
+    const { count, error } = await this.db.from("agent_runs").select("id", { count: "exact", head: true }).eq("agent_id", agentId).in("status", ["claimed", "working"]);
+    if (error) throw new Error(error.message);
+    return count ?? 0;
+  }
+
+  async countRunsSince(agentId: string, sinceIso: string) {
+    const { count, error } = await this.db.from("agent_runs").select("id", { count: "exact", head: true }).eq("agent_id", agentId).gte("started_at", sinceIso).neq("status", "skipped");
+    if (error) throw new Error(error.message);
+    return count ?? 0;
+  }
+
+  async listCandidateBounties(agentId: string) {
+    const [bounties, runs, matches] = await Promise.all([
+      this.db.from("bounties").select(BOUNTY_COLUMNS).eq("status", "active").gt("deadline", new Date().toISOString()).order("created_at", { ascending: false }).limit(100),
+      this.db.from("agent_runs").select("bounty_id").eq("agent_id", agentId),
+      this.db.from("bounty_matches").select("bounty_id,score,notification_status").eq("agent_id", agentId),
+    ]);
+    const taken = new Set((must(runs) ?? []).map((row) => row.bounty_id as string));
+    const matchRows = must(matches) ?? [];
+    const declined = new Set(matchRows.filter((row) => row.notification_status === "declined").map((row) => row.bounty_id as string));
+    const scores = new Map(matchRows.map((row) => [row.bounty_id as string, Number(row.score)]));
+    return (must(bounties) ?? [])
+      .filter((row) => !taken.has(row.id as string) && !declined.has(row.id as string))
+      .map((row) => asBounty(row as Record<string, unknown>, scores.get(row.id as string)));
+  }
+
+  async getBounty(bountyId: string) {
+    const row = must(await this.db.from("bounties").select(BOUNTY_COLUMNS).eq("id", bountyId).maybeSingle());
+    return row ? asBounty(row as Record<string, unknown>) : null;
+  }
+
+  async claimRun(input: { agentId: string; agentName: string; bountyId: string; matchScore: number; bidBaseUnits: string }) {
+    const { data, error } = await this.db.from("agent_runs").insert({
+      agent_id: input.agentId, agent_name: input.agentName.slice(0, 100), bounty_id: input.bountyId, match_score: input.matchScore, bid_base_units: input.bidBaseUnits, status: "claimed",
+    }).select("id").single();
+    if (error?.code === "23505") return null;
+    if (error) throw new Error(error.message);
+    return { id: data.id as string };
+  }
+
+  async updateRun(runId: string, patch: Record<string, unknown>) {
+    must(await this.db.from("agent_runs").update(patch).eq("id", runId));
+  }
+
+  async failStaleRuns(olderThanIso: string) {
+    const rows = must(await this.db.from("agent_runs").update({ status: "failed", error: "Run timed out", finished_at: new Date().toISOString() })
+      .in("status", ["claimed", "working"]).lt("started_at", olderThanIso).select("id"));
+    return rows?.length ?? 0;
+  }
+
+  async acceptMatch(input: { agentId: string; bountyId: string; score: number }) {
+    must(await this.db.from("bounty_matches").upsert({
+      bounty_id: input.bountyId, agent_id: input.agentId, score: Math.min(1, Math.max(0, input.score)),
+      notification_status: "accepted", response_at: new Date().toISOString(),
+    }, { onConflict: "bounty_id,agent_id" }));
+  }
+
+  async createSubmission(input: { bountyId: string; agentId: string; proposedAmountBaseUnits: string; deliverableType: "text" | "external_link"; deliverableUrl: string | null; description: string }) {
+    const data = must(await this.db.from("submissions").insert({
+      bounty_id: input.bountyId, agent_id: input.agentId, proposed_amount_base_units: input.proposedAmountBaseUnits,
+      deliverable_type: input.deliverableType, deliverable_url: input.deliverableUrl, storage_path: null, description: input.description,
+    }).select("id").single()) as { id: string };
+    await this.db.from("audit_logs").insert({ actor_id: null, action: "agent_autosubmitted", entity_type: "submission", entity_id: data.id, details: { agentId: input.agentId, bountyId: input.bountyId } });
+    return { id: data.id as string };
+  }
+
+  async saveAssistantId(agentId: string, assistantId: string) {
+    must(await this.db.from("agents").update({ backboard_assistant_id: assistantId }).eq("id", agentId));
+  }
+
+  async logEvent(input: { agentId: string; runId: string | null; kind: string; message: string; data?: Record<string, unknown> }) {
+    const { error } = await this.db.from("agent_run_events").insert({ agent_id: input.agentId, run_id: input.runId, kind: input.kind, message: input.message.slice(0, 1000), data: input.data ?? {} });
+    if (error) console.error("agent event insert failed", error.message);
+  }
+}
