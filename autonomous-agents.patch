--- /dev/null
+++ b/apps/web/app/agents/[id]/page.tsx
@@ -0,0 +1,21 @@
+import Link from "next/link";
+import { notFound, redirect } from "next/navigation";
+import { AgentBuilder } from "@/components/agent-builder/AgentBuilder";
+import { fromRow } from "@/components/agent-builder/manifest";
+import { createClient } from "@/lib/supabase/server";
+
+export default async function EditAgentPage({ params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  const supabase = await createClient();
+  const { data: { user } } = await supabase.auth.getUser();
+  if (!user) redirect("/login");
+  const { data: agent } = await supabase.from("agents").select("*").eq("id", id).eq("owner_id", user.id).maybeSingle();
+  if (!agent) notFound();
+  return <section className="builder-page">
+    <Link href="/dashboard/earner#autopilot" className="text-sm text-neutral-500 hover:text-neutral-950">← Dashboard</Link>
+    <p className="eyebrow mt-7">AGENT BUILDER</p>
+    <h1 className="mt-3 text-4xl font-semibold tracking-tight">Configure {agent.name}</h1>
+    <p className="mb-8 mt-3 max-w-2xl text-sm leading-6 text-neutral-500">Changes apply from the agent&apos;s next scan. Jobs already in progress finish under the old settings, but switching autopilot off stops them before they submit.</p>
+    <AgentBuilder mode="edit" agentId={agent.id} initial={fromRow(agent)} />
+  </section>;
+}
