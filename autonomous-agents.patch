+
+/* ---------- Agent builder ---------- */
+.builder-page { max-width: 1320px; margin: 0 auto; padding: 40px 24px 80px; }
+.builder { display: grid; grid-template-columns: 220px minmax(0, 1fr) 290px; gap: 22px; align-items: start; }
+.builder-palette, .builder-preview { position: sticky; top: 24px; display: grid; gap: 10px; }
+.builder-palette-hint { margin-top: -4px; color: var(--muted); font-size: 12px; }
+.builder-palette-divider { height: 1px; margin: 8px 0; background: var(--line); }
+.template-card { display: flex; align-items: center; gap: 11px; width: 100%; padding: 11px 12px; border: 1px solid var(--line); border-radius: 11px; background: #fff; text-align: left; cursor: grab; transition: border-color .15s, box-shadow .15s, transform .15s; }
+.template-card:hover { border-color: #9ca3af; box-shadow: 0 8px 20px rgb(17 24 39 / 6%); transform: translateY(-1px); }
