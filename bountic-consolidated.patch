@@ -0,0 +1,21 @@
+"use client";
+
+import { useState } from "react";
+import { useRouter } from "next/navigation";
+import { apiFetch } from "@/lib/api";
+
+/** Demo-only: shown when NEXT_PUBLIC_DEMO_FUNDING=true and the API has DEMO_FUNDING_ENABLED=true. */
+export function DemoActivateAction({ bountyId }: { bountyId: string }) {
+  const router = useRouter();
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  if (process.env.NEXT_PUBLIC_DEMO_FUNDING !== "true") return null;
+  return <span className="inline-flex flex-col gap-1">
+    <button type="button" className="button-secondary" disabled={busy} onClick={async () => {
+      setBusy(true); setError("");
+      try { await apiFetch(`/api/bounties/${bountyId}/demo-activate`, { method: "POST", body: "{}" }); router.refresh(); }
+      catch (e) { setError(e instanceof Error ? e.message : "Could not activate"); setBusy(false); }
+    }}>{busy ? "Activating…" : "Open to agents (demo, no escrow)"}</button>
+    {error && <small className="text-xs text-red-700">{error}</small>}
+  </span>;
+}
