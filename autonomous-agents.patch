+.template-card small { display: block; color: var(--muted); font-size: 11px; }
+.template-emoji { display: grid; width: 32px; height: 32px; flex: none; place-items: center; border-radius: 9px; background: var(--wash); font-size: 16px; }
+.builder-link { color: var(--muted); font-size: 12px; text-align: left; text-decoration: underline; }
+.builder-canvas { position: relative; display: grid; gap: 16px; padding: 4px; border: 1.5px dashed transparent; border-radius: 16px; transition: border-color .15s, background .15s; }
+.builder-canvas.is-dragging { border-color: #111; background: #fafafa; }
+.drop-hint { position: absolute; inset: 0; z-index: 5; display: grid; place-items: center; border-radius: 16px; background: rgb(255 255 255 / 82%); font-size: 15px; font-weight: 650; opacity: 0; pointer-events: none; transition: opacity .15s; }
+.builder-canvas.is-dragging .drop-hint { opacity: 1; }
+.builder-section { border: 1px solid var(--line); border-radius: 13px; background: #fff; padding: 20px 22px 22px; }
+.builder-section > header { display: flex; gap: 12px; margin-bottom: 18px; }
+.builder-section h2 { font-size: 16px; font-weight: 650; letter-spacing: -.02em; }
+.builder-section header p { margin-top: 2px; color: var(--muted); font-size: 12px; }
+.builder-step { display: grid; width: 24px; height: 24px; flex: none; place-items: center; border-radius: 50%; background: #111; color: #fff; font-size: 11px; font-weight: 700; }
+.builder-actions { position: sticky; bottom: 0; display: flex; align-items: center; justify-content: flex-end; gap: 14px; padding: 14px 0; background: linear-gradient(to top, #fff 70%, rgb(255 255 255 / 0)); }
+.field-hint { display: block; margin-top: 6px; color: #8b93a0; font-size: 11px; font-weight: 400; }
+.notice-ok { border: 1px solid #bbf7d0; border-radius: 10px; background: #f0fdf4; padding: 12px 14px; color: #166534; font-size: 13px; }
+.chip-field { display: flex; min-height: 44px; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 8px; padding: 7px 9px; border: 1px solid #d1d5db; border-radius: 10px; background: #fff; }
+.chip-field:focus-within { border-color: #6b7280; box-shadow: 0 0 0 3px rgb(17 24 39 / 7%); }
+.chip-field input { min-width: 120px; flex: 1; border: 0; outline: 0; font-size: 14px; font-weight: 400; }
+.chip { display: inline-flex; align-items: center; gap: 5px; border: 1px solid var(--line); border-radius: 999px; background: var(--wash); padding: 3px 4px 3px 10px; color: #374151; font-size: 12px; font-weight: 500; }
+.chip button { display: grid; width: 18px; height: 18px; place-items: center; border-radius: 50%; color: #6b7280; }
+.chip button:hover { background: #e5e7eb; color: #111; }
+.chip-static { padding: 3px 10px; }
+.runtime-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.runtime-switch button { display: grid; gap: 3px; padding: 14px; border: 1px solid var(--line); border-radius: 11px; background: #fff; text-align: left; }
+.runtime-switch button strong { font-size: 13px; }
+.runtime-switch button small { color: var(--muted); font-size: 11px; }
+.runtime-switch button.is-active { border-color: #111; box-shadow: inset 0 0 0 1px #111; }
+.code-hint { overflow-x: auto; border-radius: 10px; background: #0f1115; padding: 14px; color: #d1d5db; font-size: 11.5px; line-height: 1.6; }
+.range { width: 100%; margin-top: 12px; accent-color: #111; }
+.toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px; border: 1px solid var(--line); border-radius: 11px; background: #fff; text-align: left; }
+.toggle-row strong { display: block; font-size: 13px; }
+.toggle-row small { display: block; color: var(--muted); font-size: 11px; }
+.toggle-track, .mini-toggle { position: relative; width: 40px; height: 23px; flex: none; border-radius: 999px; background: #d1d5db; transition: background .15s; }
+.toggle-thumb, .mini-toggle span { position: absolute; top: 3px; left: 3px; width: 17px; height: 17px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / 20%); transition: transform .15s; }
+.toggle-row.is-on .toggle-track, .mini-toggle.is-on { background: #16a34a; }
+.toggle-row.is-on .toggle-thumb, .mini-toggle.is-on span { transform: translateX(17px); }
+.toggle-row.is-on { border-color: #bbf7d0; }
+.agent-preview { display: grid; gap: 12px; border: 1px solid var(--line); border-radius: 14px; background: #fff; padding: 16px; box-shadow: 0 10px 30px rgb(17 24 39 / 6%); }
+.agent-preview-head { display: grid; grid-template-columns: 38px 1fr auto; align-items: center; gap: 10px; }
+.agent-preview-head h3 { font-size: 15px; font-weight: 650; }
+.agent-preview-head p { color: var(--muted); font-size: 11px; }
+.agent-avatar { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 11px; background: #111; color: #fff; font-weight: 700; }
+.agent-preview-desc { color: #4b5563; font-size: 12px; line-height: 1.55; }
+.agent-preview-limits { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--soft-line); padding-top: 10px; }
+.agent-preview-limits dt { color: #8b93a0; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }
+.agent-preview-limits dd { font-size: 15px; font-weight: 650; }
+.autopilot-badge { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); border-radius: 999px; padding: 4px 8px; color: #6b7280; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
+.autopilot-badge i, .autopilot-state i { width: 7px; height: 7px; border-radius: 50%; background: #9ca3af; }
+.autopilot-badge.is-on { border-color: #bbf7d0; background: #f0fdf4; color: #166534; }
+.autopilot-badge.is-on i, .autopilot-state.is-live i { background: #16a34a; animation: pulse 1.6s ease-in-out infinite; }
+.builder-summary { color: #374151; font-size: 13px; line-height: 1.65; }
+@keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgb(22 163 74 / 45%); } 50% { box-shadow: 0 0 0 5px rgb(22 163 74 / 0%); } }
+@media (max-width: 1100px) { .builder { grid-template-columns: 1fr; } .builder-palette, .builder-preview { position: static; } .builder-palette { grid-template-columns: repeat(2, 1fr); } .builder-palette > .eyebrow, .builder-palette-hint, .builder-palette-divider { grid-column: 1 / -1; } }
+
+/* ---------- Autopilot feed ---------- */
+.autopilot-agents { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 12px; }
+.autopilot-agent { border: 1px solid var(--line); border-radius: 12px; background: #fff; padding: 15px; }
+.autopilot-agent.is-new { border-color: #111; box-shadow: 0 0 0 3px rgb(17 24 39 / 6%); }
+.autopilot-agent h3 { font-size: 14px; font-weight: 650; }
+.autopilot-state { display: flex; align-items: center; gap: 6px; margin-top: 3px; color: var(--muted); font-size: 11px; }
+.autopilot-state.is-live { color: #166534; }
+.mini-toggle:disabled { opacity: .5; }
+.usage { display: grid; grid-template-columns: 38px 1fr 40px; align-items: center; gap: 8px; margin-top: 10px; color: #6b7280; font-size: 10px; }
+.usage span:last-child { text-align: right; font-variant-numeric: tabular-nums; }
+.usage-bar { height: 5px; overflow: hidden; border-radius: 999px; background: #f1f2f4; }
+.usage-bar i { display: block; height: 100%; border-radius: inherit; background: #111; transition: width .4s ease; }
+.autopilot-columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 22px; margin-top: 20px; }
+.autopilot-subhead { margin-bottom: 10px; color: #6b7280; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
+.event-log { display: grid; gap: 0; border-left: 1px solid var(--line); margin-left: 5px; }
+.event { position: relative; display: flex; gap: 10px; padding: 0 0 13px 16px; }
+.event i { position: absolute; top: 4px; left: -5px; width: 9px; height: 9px; border: 2px solid #fff; border-radius: 50%; background: #9ca3af; }
+.event p { font-size: 12.5px; line-height: 1.45; }
+.event small { color: #8b93a0; font-size: 10.5px; }
+.event-claimed i { background: #2563eb; } .event-working i { background: #f59e0b; } .event-drafted i { background: #7c3aed; }
+.event-submitted i { background: #16a34a; } .event-failed i { background: #dc2626; } .event-limit i, .event-paused i { background: #111; }
+.run-card { border: 1px solid var(--line); border-radius: 10px; background: #fff; padding: 12px 14px; }
+.run-title { display: block; overflow: hidden; font-size: 13px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
+.run-title:hover { text-decoration: underline; }
+.run-card small { color: #8b93a0; font-size: 10.5px; }
+.run-status { border-radius: 999px; padding: 3px 8px; background: #f3f4f6; color: #4b5563; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
+.run-working, .run-claimed { background: #fffbeb; color: #92400e; } .run-submitted { background: #f0fdf4; color: #166534; }
+.run-awaiting_review { background: #eef2ff; color: #3730a3; } .run-failed { background: #fef2f2; color: #991b1b; }
+.deliverable { max-height: 320px; overflow: auto; margin-top: 8px; border-radius: 9px; background: var(--wash); padding: 12px; color: #374151; font-size: 12px; line-height: 1.55; white-space: pre-wrap; }
+@media (max-width: 900px) { .autopilot-columns { grid-template-columns: 1fr; } }
