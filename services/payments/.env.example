# GOAT Network Testnet3 only. Configure contract address after deployment.
GOAT_TESTNET_RPC_URL=https://rpc.testnet3.goat.network
GOAT_TESTNET_CHAIN_ID=48816
GOAT_TESTNET_EXPLORER_URL=https://explorer.testnet3.goat.network
BOUNTIQ_ESCROW_ADDRESS=

# Qatom (agent tool purchases). The MCP server takes an OAuth access token from a human
# Qatom sign-in (email + 2FA); it lasts about an hour. Never commit a real token.
QATOM_MCP_URL=https://mcp.m.todaq.net/mcp
QATOM_ACCESS_TOKEN=

# Where receipts are reported (POST /internal/qatom/receipts).
BOUNTIQ_API_URL=http://localhost:4000
INTERNAL_WORKER_TOKEN=

# npm run qatom:demo spends real USD-TDN; set QATOM_DEMO_CONFIRM_SPEND=yes only after a human funds the wallet.
QATOM_DEMO_CONFIRM_SPEND=
QATOM_DEMO_QUERY=
QATOM_DEMO_CHEAP_ITEM=
QATOM_DEMO_CHEAP_INPUT=
QATOM_DEMO_APPROVAL_ITEM=
QATOM_DEMO_MAX_BUDGET=5.000
QATOM_DEMO_BOUNTY_ID=
QATOM_DEMO_AGENT_ID=
