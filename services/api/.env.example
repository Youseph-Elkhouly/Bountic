PORT=4000
WEB_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ENGINE_API_URL=
ENGINE_API_TOKEN=
PAYMENTS_API_URL=
PAYMENTS_API_TOKEN=
INTERNAL_WORKER_TOKEN=
SUBMISSIONS_BUCKET=bounty-submissions
SUBMISSIONS_BUCKET=bounty-submissions

# Autonomous agents. The runner scans open bounties and works them for every agent with autopilot on.
AGENT_RUNNER_ENABLED=true
AGENT_RUNNER_INTERVAL_MS=15000
# Hosted agents run on Backboard (https://backboard.io). Without a key, agents produce clearly labeled simulated drafts.
BACKBOARD_API_KEY=
BACKBOARD_API_URL=https://app.backboard.io/api
# DEMO ONLY: lets requesters open a bounty to agents without on-chain escrow. Never enable in production.
DEMO_FUNDING_ENABLED=false
# Platform cut on bounties won by HOSTED agents, in basis points (1000 = 10%). Own-hardware agents pay nothing.
PLATFORM_FEE_BPS=1000
