+++ b/apps/web/components/agent-builder/AgentBuilder.tsx
@@ -0,0 +1,217 @@
+"use client";
+
+import { DragEvent, FormEvent, KeyboardEvent, useMemo, useRef, useState } from "react";
+import { useRouter } from "next/navigation";
+import { apiFetch } from "@/lib/api";
+import { AgentDraft, MODELS, TEMPLATES, emptyDraft, parseManifest, toApiBody, toManifest } from "./manifest";
+
+type Props = { mode: "create" | "edit"; agentId?: string; initial?: AgentDraft };
+
+const fmt = (value: string) => { try { return BigInt(value || "0").toLocaleString(); } catch { return value; } };
+
+function ChipInput({ label, values, onChange, placeholder }: { label: string; values: string[]; onChange: (next: string[]) => void; placeholder: string }) {
+  const [text, setText] = useState("");
+  const add = (raw: string) => {
+    const parts = raw.split(",").map((part) => part.trim()).filter(Boolean);
+    if (parts.length) onChange([...new Set([...values, ...parts])].slice(0, 30));
+    setText("");
+  };
+  const onKey = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.key === "Enter" || event.key === ",") { event.preventDefault(); add(text); }
+    if (event.key === "Backspace" && !text && values.length) onChange(values.slice(0, -1));
+  };
+  return <label className="field-label">{label}
+    <div className="chip-field">
+      {values.map((value) => <span className="chip" key={value}>{value}<button type="button" aria-label={`Remove ${value}`} onClick={() => onChange(values.filter((item) => item !== value))}>×</button></span>)}
+      <input value={text} onChange={(event) => setText(event.target.value)} onKeyDown={onKey} onBlur={() => text && add(text)} placeholder={values.length ? "" : placeholder} maxLength={80} />
+    </div>
+  </label>;
+}
+
+function Toggle({ checked, onChange, label, hint }: { checked: boolean; onChange: (value: boolean) => void; label: string; hint: string }) {
+  return <button type="button" role="switch" aria-checked={checked} className={`toggle-row ${checked ? "is-on" : ""}`} onClick={() => onChange(!checked)}>
+    <span><strong>{label}</strong><small>{hint}</small></span><span className="toggle-track"><span className="toggle-thumb" /></span>
+  </button>;
+}
+
+function NumberField({ label, value, onChange, min, max, hint }: { label: string; value: number; onChange: (value: number) => void; min: number; max: number; hint?: string }) {
+  return <label className="field-label">{label}<input className="field" type="number" min={min} max={max} value={value} onChange={(event) => onChange(Math.min(max, Math.max(min, Number(event.target.value) || min)))} />{hint && <span className="field-hint">{hint}</span>}</label>;
+}
+
+export function AgentBuilder({ mode, agentId, initial }: Props) {
+  const router = useRouter();
+  const [draft, setDraft] = useState<AgentDraft>(initial ?? emptyDraft);
+  const [dragging, setDragging] = useState(false);
+  const [notice, setNotice] = useState<{ tone: "ok" | "error"; text: string } | null>(null);
+  const [saving, setSaving] = useState(false);
+  const fileInput = useRef<HTMLInputElement>(null);
+  const set = <K extends keyof AgentDraft>(key: K, value: AgentDraft[K]) => setDraft((current) => ({ ...current, [key]: value }));
+
+  const applyTemplate = (id: string) => {
+    const template = TEMPLATES.find((item) => item.id === id);
+    if (!template) return;
+    setDraft((current) => ({ ...current, ...template.draft, payoutWallet: current.payoutWallet }));
+    setNotice({ tone: "ok", text: `Loaded the ${template.title} template. Adjust anything below.` });
+  };
+  const loadFile = async (file: File) => {
+    if (file.size > 64_000) { setNotice({ tone: "error", text: "That file is too large for an agent manifest." }); return; }
+    try {
+      const { draft: imported, ignored } = parseManifest(await file.text());
+      setDraft((current) => ({ ...current, ...imported, payoutWallet: current.payoutWallet }));
+      setNotice({ tone: "ok", text: `Imported ${imported.name ?? "agent"} from ${file.name}.${ignored.length ? ` Ignored: ${ignored.join(", ")}.` : ""} Payout wallets are never imported; add yours below.` });
+    } catch (error) { setNotice({ tone: "error", text: error instanceof Error ? error.message : "Could not read that file." }); }
+  };
+  const onDrop = (event: DragEvent<HTMLFormElement>) => {
+    event.preventDefault(); setDragging(false);
+    const template = event.dataTransfer.getData("application/x-bountic-template");
+    if (template) return applyTemplate(template);
+    const file = event.dataTransfer.files?.[0];
+    if (file) void loadFile(file);
+  };
+  const exportManifest = () => {
+    const blob = new Blob([JSON.stringify(toManifest(draft), null, 2)], { type: "application/json" });
+    const link = document.createElement("a");
+    link.href = URL.createObjectURL(blob); link.download = `${(draft.name || "agent").toLowerCase().replace(/[^a-z0-9]+/g, "-")}.bountic.agent.json`;
+    link.click(); URL.revokeObjectURL(link.href);
+  };
+
+  const problems = useMemo(() => {
+    const list: string[] = [];
+    if (!draft.name.trim()) list.push("Give your agent a name.");
+    if (draft.runtime === "webhook" && !/^https:\/\/[^/\s]+\.[^/\s]+/.test(draft.webhookUrl)) list.push("A bring-your-own agent needs a public HTTPS endpoint.");
+    if (draft.payoutWallet && !/^0x[0-9a-fA-F]{40}$/.test(draft.payoutWallet)) list.push("The payout address doesn't look like a GOAT (EVM) address.");
+    if (draft.maxBidBaseUnits && BigInt(draft.maxBidBaseUnits || "0") < BigInt(draft.minRewardBaseUnits || "0")) list.push("Max bid is below the minimum reward, so the agent could never bid.");
+    if (!/^(0|[1-9][0-9]*)$/.test(draft.minRewardBaseUnits || "0") || (draft.maxBidBaseUnits && !/^[1-9][0-9]*$/.test(draft.maxBidBaseUnits))) list.push("Rewards and bids are whole numbers of base units.");
+    return list;
+  }, [draft]);
+
+  async function save(event: FormEvent) {
+    event.preventDefault();
+    if (problems.length) { setNotice({ tone: "error", text: problems[0] }); return; }
+    setSaving(true); setNotice(null);
+    try {
+      const body: Record<string, unknown> = toApiBody(draft);
+      // Re-sending an unchanged wallet would reset its verification.
+      if (mode === "edit" && draft.payoutWallet === (initial?.payoutWallet ?? "")) delete body.payoutWallet;
+      if (mode === "create") {
+        const { agent } = await apiFetch<{ agent: { id: string } }>("/api/agents", { method: "POST", body: JSON.stringify(body) });
+        router.push(`/dashboard/earner?agent=${agent.id}#autopilot`);
+      } else {
+        await apiFetch(`/api/agents/${agentId}`, { method: "PATCH", body: JSON.stringify(body) });
+        router.push(`/dashboard/earner#autopilot`);
+      }
+      router.refresh();
+    } catch (error) { setNotice({ tone: "error", text: error instanceof Error ? error.message : "Could not save the agent" }); setSaving(false); }
+  }
+
+  const summary = [
+    draft.autonomyEnabled ? "Runs on its own" : "Waits for you to press Run now",
+    `takes up to ${draft.maxConcurrentJobs} job${draft.maxConcurrentJobs === 1 ? "" : "s"} at a time and ${draft.maxJobsPerDay} per day`,
+    draft.categories.length ? `only in ${draft.categories.join(", ")}` : "in any category",
+    draft.skills.length ? `when a bounty asks for ${draft.skills.slice(0, 3).join(", ")}${draft.skills.length > 3 ? "…" : ""}` : "for any skill",
+    BigInt(draft.minRewardBaseUnits || "0") > BigInt(0) ? `skips bounties under ${fmt(draft.minRewardBaseUnits)} base units` : "takes any reward size",
+    `bids ${draft.bidPercent}% of the budget${draft.maxBidBaseUnits ? ` (never more than ${fmt(draft.maxBidBaseUnits)})` : ""}`,
+    draft.autoSubmit ? "and submits its work automatically." : "and holds every draft for your approval.",
+  ].join(", ").replace(/, and/, " and");
+
+  return <div className="builder">
+    <aside className="builder-palette" aria-label="Agent templates">
+      <p className="eyebrow">START FROM</p>
+      <p className="builder-palette-hint">Drag a template onto the canvas, or click it.</p>
+      {TEMPLATES.map((template) => <button type="button" key={template.id} className="template-card" draggable
+        onDragStart={(event) => { event.dataTransfer.setData("application/x-bountic-template", template.id); event.dataTransfer.effectAllowed = "copy"; }}
+        onClick={() => applyTemplate(template.id)}>
+        <span className="template-emoji" aria-hidden>{template.emoji}</span><span><strong>{template.title}</strong><small>{template.blurb}</small></span>
+      </button>)}
+      <div className="builder-palette-divider" />
+      <p className="eyebrow">ALREADY HAVE ONE?</p>
+      <button type="button" className="button-secondary w-full" onClick={() => fileInput.current?.click()}>Import bountic.agent.json</button>
+      <input ref={fileInput} type="file" accept="application/json,.json" hidden onChange={(event) => { const file = event.target.files?.[0]; if (file) void loadFile(file); event.target.value = ""; }} />
+      <button type="button" className="builder-link" onClick={exportManifest}>Export this agent as JSON</button>
+    </aside>
+
+    <form className={`builder-canvas ${dragging ? "is-dragging" : ""}`} onSubmit={save}
+      onDragOver={(event) => { event.preventDefault(); setDragging(true); }} onDragLeave={(event) => { if (!event.currentTarget.contains(event.relatedTarget as Node)) setDragging(false); }} onDrop={onDrop}>
+      <div className="drop-hint" aria-hidden={!dragging}>Drop to load this agent</div>
+      {notice && <p className={notice.tone === "error" ? "notice-error" : "notice-ok"} role="status">{notice.text}</p>}
+
+      <section className="builder-section">
+        <header><span className="builder-step">1</span><div><h2>Identity</h2><p>What the agent is and the work it should look for.</p></div></header>
+        <div className="grid gap-4 sm:grid-cols-2">
